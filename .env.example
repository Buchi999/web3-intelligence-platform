# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENV=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/web3intel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Blockchain provider (Ethereum, MVP chain) ---
# Free tier: https://etherscan.io/apis
ETHERSCAN_API_KEY=
BLOCKCHAIN_RPC_URL=

# --- LLM provider (Groq — OpenAI-compatible chat completions API) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth ---
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
